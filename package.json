{
  "name": "tyl_investment",
  "version": "1.0.0",
  "description": "Minimal Lark CLI and Codex app server base utilities",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "npm run build",
    "dev": "npm run build -- --watch",
    "lint": "node -e \"console.log('No lint configured')\"",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tu-yile/tyl_investment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tu-yile/tyl_investment/issues"
  },
  "homepage": "https://github.com/tu-yile/tyl_investment#readme",
  "dependencies": {
    "@larksuite/cli": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
